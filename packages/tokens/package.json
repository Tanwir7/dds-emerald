{
  "name": "@dds/emerald-tokens",
  "version": "0.1.0",
  "description": "Design tokens for the DDS Emerald design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tanwir7/dds-emerald.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Tanwir7/dds-emerald#readme",
  "bugs": {
    "url": "https://github.com/Tanwir7/dds-emerald/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/tokens.css",
    "./fonts": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "generate": "node scripts/generate-tokens.mjs",
    "lint": "pnpm --dir ../.. exec eslint packages/tokens",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contrast": "node scripts/check-contrast.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@dds/typescript-config": "workspace:*",
    "@dds/vitest-config": "workspace:*",
    "@types/node": "^22",
    "tsup": "^8.x.x",
    "typescript": "^5.x.x",
    "vitest": "^4.1.5"
  }
}
