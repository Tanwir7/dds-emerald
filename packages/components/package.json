{
  "name": "@dds/emerald",
  "version": "0.1.0",
  "description": "Emerald component library by Digital Dev Studio",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/check-dist.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "pnpm --dir ../.. exec eslint packages/components/src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@dds/emerald-tokens": "^0.1.0",
    "lucide-react": "^1.7.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@dds/eslint-config": "workspace:*",
    "@dds/emerald-tokens": "workspace:*",
    "@dds/typescript-config": "workspace:*",
    "@dds/vitest-config": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@storybook/addon-docs": "^10.3.6",
    "@tanstack/react-table": "^8",
    "@tanstack/react-virtual": "^3",
    "@storybook/react-vite": "^10.3.6",
    "@types/node": "^25",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "clsx": "^2.x.x",
    "date-fns": "^3.6.0",
    "jest-axe": "^10.0.0",
    "lucide-react": "^1.7.0",
    "react": "19.2.4",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.2.4",
    "sass": "^1.98.0",
    "storybook": "^10.3.6",
    "typescript": "^5.x.x",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.5"
  }
}
